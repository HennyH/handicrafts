config handicrafts 'main'
	option enabled '1'
	# The reverse proxy on this router serves https and forwards here.
	option listen '127.0.0.1'
	option port '8082'
	# The shop's address, for pay links in invoices.
	option public_url 'https://www.rachelshandicrafts.com'
	# The database. Must be on storage, not /tmp. Kept across firmware
	# upgrades if left here.
	option data_dir '/srv/handicrafts'
	# Proxies whose X-Forwarded-For header is believed (the real client IP).
	list trusted_proxies '127.0.0.1'
	list trusted_proxies '::1'
	option admin_user 'rachel'
	# Where order and payment notifications go.
	option admin_email ''

config mail 'mail'
	# off, smtp, tuta or log
	option transport 'off'
	# The address mail is sent from. Tuta: the account's own address (empty)
	# or one of its aliases. SMTP: empty uses the SMTP username.
	option from ''
	# SMTP only: Tuta sends with the name set in Tuta.
	option from_name "Rachel's Handicrafts"
	option tuta_user ''
	option smtp_host ''
	option smtp_port ''
	# tls, starttls or none
	option smtp_security 'tls'
	option smtp_user ''

config payments 'payments'
	option payid ''
	option bank_account_name ''
	option bsb ''
	option account_number ''
	option monokulo_url 'https://www.monokulo.com'
	option monokulo_public_key ''

config limits 'limits'
	option ip_10min '3'
	option ip_day '10'
	option email_day '3'
	option shop_day '40'
